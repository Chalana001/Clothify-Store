<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="670.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CustomerFormController">
    <children>
        <VBox alignment="CENTER" prefHeight="400.0" prefWidth="234.0" spacing="10.0">
            <children>
                <Label prefHeight="23.0" prefWidth="186.0" text="Customer ID" textFill="#475569">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <AnchorPane prefHeight="30.0" prefWidth="191.0">
                    <children>
                        <TextField fx:id="txtId" layoutY="2.0" onAction="#txtCustomerIdOnAction" promptText="Enter Customer ID" stylesheets="@../css/my.css" />
                        <Button fx:id="btnGenId" layoutX="156.0" layoutY="11.0" mnemonicParsing="false" onAction="#btnGenIdOnAction" prefHeight="25.0" prefWidth="27.0" style="-fx-background-color: #2563EB; -fx-background-radius: 18;" text="R" textFill="WHITE" />
                    </children>
                </AnchorPane>
                <Label prefHeight="17.0" prefWidth="195.0" text="Customer Name" textFill="#475569">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <TextField fx:id="txtName" promptText="Enter Customer Name" stylesheets="@../css/my.css" />
                <Label prefHeight="17.0" prefWidth="195.0" text="Contact" textFill="#475569">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <TextField fx:id="txtContact" promptText="Enter Customer Contact Number" stylesheets="@../css/my.css" />
                <Label prefHeight="17.0" prefWidth="195.0" text="Email" textFill="#475569">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <TextField fx:id="txtEmail" promptText="Enter Customer Email" stylesheets="@../css/my.css" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="5.0">
               <children>
                      <Button fx:id="btnAddButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#btnAddButtonOnAction" prefHeight="34.0" prefWidth="90.0" stylesheets="@../css/my.css" text="Add" />
                  <Button maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#btnUpdateButtonOnAction" prefHeight="34.0" prefWidth="90.0" stylesheets="@../css/my.css" text="Update" />
               </children>
            </HBox>
            </children>
        </VBox>
        <VBox prefHeight="400.0" prefWidth="452.0">
            <children>
                <HBox alignment="CENTER" prefHeight="59.0" prefWidth="409.0" spacing="80.0">
                    <children>
                        <Label prefHeight="38.0" prefWidth="235.0" text="Customers Table" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="19.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtSearch" prefHeight="42.0" prefWidth="212.0" promptText="Search Customer..." stylesheets="@../css/my.css" />
                    </children>
                </HBox>
                <HBox prefHeight="335.0" prefWidth="409.0">
                    <children>
                        <TableView fx:id="tblCustomerTable" onContextMenuRequested="#showContextMenu" onMouseClicked="#tblOnMouseClicked" prefHeight="333.0" prefWidth="443.0">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="75.0" text="Customer ID" />
                                <TableColumn fx:id="colName" prefWidth="151.0" text="Name" />
                                <TableColumn fx:id="colContact" prefWidth="70.0" text="Contact" />
                                <TableColumn fx:id="colEmail" prefWidth="137.0" text="Email" />
                            </columns>
                        </TableView>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>
</HBox>
