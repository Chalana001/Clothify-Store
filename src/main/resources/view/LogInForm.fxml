<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" focusTraversable="true" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LogInFormController">
    <children>
        <Label alignment="CENTER" prefHeight="80.0" prefWidth="600.0" style="-fx-background-color: #2563EB; -fx-text-fill: #FFFFFF;" text="Clothify Store" textAlignment="CENTER" textOverrun="CENTER_WORD_ELLIPSIS" wrapText="true">
            <font>
                <Font name="System Bold Italic" size="37.0" />
            </font>
        </Label>
        <TextField fx:id="txtPassword" layoutX="195.0" layoutY="287.0" prefHeight="34.0" prefWidth="211.0" promptText="Enter password" stylesheets="@../css/my.css" />
        <Button fx:id="btnLogIn" layoutX="195.0" layoutY="337.0" mnemonicParsing="false" onAction="#LogInButtonOnAction" prefHeight="34.0" prefWidth="211.0" stylesheets="@../css/my.css" text="Login" />
        <TextField fx:id="txtUserName" layoutX="195.0" layoutY="218.0" prefHeight="34.0" prefWidth="211.0" promptText="Enter username" stylesheets="@../css/my.css" />
        <Label layoutX="195.0" layoutY="193.0" prefHeight="25.0" prefWidth="85.0" stylesheets="@../css/my.css" text="Username" />
        <Label layoutX="195.0" layoutY="262.0" prefHeight="25.0" prefWidth="85.0" stylesheets="@../css/my.css" text="Password" />
        <Label alignment="CENTER" layoutX="198.0" layoutY="129.0" prefHeight="46.0" prefWidth="204.0" style="-fx-text-fill: #6B7280;" text="Sign in to access you store">
            <font>
                <Font size="15.0" />
            </font>
        </Label>
        <Label layoutX="241.0" layoutY="109.0" style="-fx-text-fill: #111827;" text="Welcome">
            <font>
                <Font name="System Bold" size="27.0" />
            </font>
        </Label>
        <Label fx:id="lblErrorMsg" alignment="CENTER" disable="true" layoutX="194.0" layoutY="379.0" prefHeight="16.0" prefWidth="211.0" style="-fx-text-fill: #DC2626;" stylesheets="@../css/my.css" textAlignment="CENTER" />
    </children>
</AnchorPane>
